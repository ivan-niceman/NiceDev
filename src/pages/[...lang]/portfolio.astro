---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { portfolioProjects } from '../../data/portfolio';
import { translations } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } }
  ];
}

const { lang: paramLang } = Astro.params;
const lang = (paramLang === 'en' ? 'en' : 'ru') as 'ru' | 'en';
const isRu = lang === 'ru';
const t = translations[lang];
const homeLink = isRu ? '/' : '/en/';
const canonicalPath = isRu ? '/portfolio' : '/en/portfolio';

const pageTitle = isRu
  ? "Портфолио проектов NiceDev — Примеры сайтов и шаблонов"
  : "Project Portfolio NiceDev — Website Showcase & Templates";

const pageDescription = isRu
  ? "Примеры сайтов и готовых шаблонов веб-студии NiceDev. Интерактивная демонстрация десктопной и мобильной версий. Оцените качество наших работ!"
  : "Explore flagship websites and templates crafted by NiceDev Web Studio. Live animated desktop and mobile previews. Inspect our design quality.";

const totalCount = portfolioProjects.length;
const initialCount = 6;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonicalPath={canonicalPath}
>
  {/* Luminous Ambient Background Engine */}
  <div class="ambient-bg" aria-hidden="true">
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>
    <div class="grid-overlay"></div>
  </div>

  <Header lang={lang} />

  <main id="main-content" class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href={homeLink} class="breadcrumb-link">{isRu ? 'Главная' : 'Home'}</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">/</li>
        <li class="breadcrumb-current" aria-current="page">{isRu ? 'Портфолио' : 'Portfolio'}</li>
      </ol>
    </nav>
    <section aria-labelledby="portfolio-page-title">
        <div class="page-intro__header reveal">
          <h1 id="portfolio-page-title" class="page-intro__title">
            {isRu ? 'Наши проекты' : 'Our Projects'}
            <span class="title-gold-dot">.</span>
          </h1>

          <p class="page-intro__desc">
            {isRu
              ? 'В каждой карточке представлена десктопная версия сайта и мобильный вид со смартфона в непрерывном движении. Наведите курсор на любую карточку, чтобы остановить прокрутку и рассмотреть детали.'
              : 'Every project card features full desktop and mobile views in continuous fluid motion. Hover over any card to pause the preview and inspect design details.'}
          </p>
        </div>
    </section>

    {/* Gallery Section */}
    <section aria-label={isRu ? "Галерея проектов" : "Projects Gallery"}>
      <div class="portfolio-grid" id="portfolio-grid">
        {portfolioProjects.map((project, idx) => (
          <div 
            class={`portfolio-item-wrapper ${idx >= initialCount ? 'portfolio-item--hidden' : ''}`}
            data-index={idx}
          >
            <ProjectCard 
              project={project} 
              lang={lang} 
              priority={idx < 2} 
            />
          </div>
        ))}
      </div>

      <div class="gallery-controls" id="gallery-controls">
          <div class="controls-status">
            <span id="items-counter-text">
              {isRu 
                ? `Показано ${initialCount} из ${totalCount} проектов` 
                : `Showing ${initialCount} of ${totalCount} projects`}
            </span>
          </div>

          <button
            type="button"
            class="btn btn--gold load-more-btn"
            id="load-more-btn"
            data-initial={initialCount}
            data-total={totalCount}
            data-batch="4"
          >
            <span>{isRu ? 'Показать еще проекты' : 'Load More Projects'}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="load-more-icon">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        </div>
    </section>

    {/* Bottom CTA Banner */}
    <section class="portfolio-cta-section" id="portfolio-cta-section">
      <div class="container">
        <div class="portfolio-cta-card">
          <div class="cta-glow" aria-hidden="true"></div>
          <div class="cta-content">
            <span class="badge cta-badge" id="portfolio-cta-badge">{t.portfolio.ctaBadge}</span>
            <h2 class="cta-title" id="portfolio-cta-title">
              {t.portfolio.ctaTitle}
            </h2>
            <p class="cta-desc" id="portfolio-cta-desc">
              {t.portfolio.ctaDesc}
            </p>
            <div class="cta-actions">
              <a href={`${homeLink}#contact`} class="btn btn--gold" id="portfolio-cta-btn-contact">
                <span>{t.portfolio.ctaDiscuss}</span>
              </a>
              <a href={`${homeLink}#calculator`} class="btn btn--glass" id="portfolio-cta-btn-calc">
                <span>{t.portfolio.ctaEstimate}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<script is:inline>
  // Progressive Load More Logic
  (function() {
    const loadMoreBtn = document.getElementById('load-more-btn');
    const counterText = document.getElementById('items-counter-text');
    const isRussian = document.documentElement.lang === 'ru' || !window.location.pathname.startsWith('/en');

    if (!loadMoreBtn || !counterText) return;

    let currentVisible = parseInt(loadMoreBtn.getAttribute('data-initial') || '6', 10);
    const totalCount = parseInt(loadMoreBtn.getAttribute('data-total') || '12', 10);
    const batchSize = parseInt(loadMoreBtn.getAttribute('data-batch') || '4', 10);

    loadMoreBtn.addEventListener('click', function() {
      const hiddenItems = Array.from(document.querySelectorAll('.portfolio-item--hidden'));
      const toShow = hiddenItems.slice(0, batchSize);

      toShow.forEach(function(item, idx) {
        // Stagger reveal animation slightly
        setTimeout(function() {
          item.classList.remove('portfolio-item--hidden');
          item.classList.add('portfolio-item--revealed');
          // Check image completion on newly revealed item
          item.querySelectorAll('.mockup-desktop__screen, .mockup-mobile__screen').forEach(function(screen) {
            var img = screen.querySelector('.mockup-scroll-img');
            if (img && img.complete && img.naturalWidth > 0) {
              screen.setAttribute('data-screen-state', 'loaded');
            }
          });
        }, idx * 60);
      });

      currentVisible += toShow.length;

      if (currentVisible >= totalCount) {
        currentVisible = totalCount;
        counterText.textContent = isRussian 
          ? `Все ${totalCount} проектов показаны`
          : `All ${totalCount} projects displayed`;
        
        loadMoreBtn.disabled = true;
        loadMoreBtn.style.opacity = '0.5';
        loadMoreBtn.style.cursor = 'default';
        loadMoreBtn.innerHTML = `<span>${isRussian ? 'Все проекты открыты' : 'All projects opened'}</span>`;
      } else {
        counterText.textContent = isRussian
          ? `Показано ${currentVisible} из ${totalCount} проектов`
          : `Showing ${currentVisible} of ${totalCount} projects`;
      }
    });
  })();
</script>

<style>
  .breadcrumb-link {
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--color-gold);
  }

  .breadcrumb-separator {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Page Intro */
  .page-intro__header {
    max-width: 840px;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(157, 78, 221, 0.12);
    border: 1px solid rgba(157, 78, 221, 0.28);
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-amethyst-light);
    margin-bottom: 16px;
  }

  .badge-pill__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00F5D4;
    box-shadow: 0 0 10px #00F5D4;
    animation: pulseGlow 2s infinite ease-in-out;
  }

  :global([data-theme="light"]) .badge-pill {
    background: rgba(109, 40, 217, 0.08);
    border-color: rgba(109, 40, 217, 0.28);
    color: var(--color-amethyst-light);
  }

  :global([data-theme="light"]) .badge-pill__pulse {
    background: var(--color-cyan-neon);
    box-shadow: 0 0 8px rgba(4, 120, 87, 0.4);
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .page-intro__title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 18px 0;
  }

  .title-gold-dot {
    color: var(--color-gold);
  }

  .page-intro__desc {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0 0 28px 0;
    max-width: 720px;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  @media (max-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  /* Hidden items for progressive load more */
  .portfolio-item--hidden {
    display: none !important;
  }

  .portfolio-item--revealed {
    animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Controls */
  .gallery-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 48px;
    gap: 14px;
  }

  .controls-status {
    font-size: 14px;
    color: var(--text-muted);
  }

  .load-more-btn {
    padding: 14px 32px;
    font-size: 0.95rem;
    cursor: pointer;
    transition: box-shadow var(--transition-fast);
  }

  .load-more-btn:hover:not(:disabled) {
    box-shadow: 0 8px 24px var(--color-gold-glow);
  }

  .load-more-icon {
    transition: transform var(--transition-fast);
  }

  .load-more-btn:hover:not(:disabled) .load-more-icon {
    transform: scale(1.15);
  }

  /* CTA Section */
  .portfolio-cta-section {
    padding: 40px 0 20px 0;
  }

  .portfolio-cta-card {
    position: relative;
    padding: 56px 40px;
    background: linear-gradient(135deg, rgba(28, 18, 43, 0.95) 0%, rgba(14, 9, 21, 0.98) 100%);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-align: center;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
  }

  :global([data-theme="light"]) .portfolio-cta-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F2F9 100%);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 20px 48px rgba(110, 60, 160, 0.08);
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(157, 78, 221, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }

  .cta-badge {
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .cta-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0 0 16px 0;
  }

  .cta-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 28px 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .portfolio-cta-card {
      padding: 36px 20px;
    }

    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
