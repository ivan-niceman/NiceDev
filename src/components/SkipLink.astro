---
export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const text = lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content';
---
<a
  href="#main-content"
  class="skip-link"
  aria-label={text}
>
  {text}
</a>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: #000;
    color: #fff;
    padding: 8px;
    z-index: 1000;
    transition: top 0.3s;
  }
  .skip-link:focus {
    top: 0;
    left: 0;
  }
</style>