---
import Hero3DIsland from './Hero3DIsland.astro';
import { translations } from '../i18n/translations';

export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const t = translations[lang];
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__grid">
      {/* Left Column: Bold Typography & CTAs */}
      <div>
        <h1 class="hero__title reveal" id="hero-heading">
          {t.hero.titleLine1} <br />
          <span class="hero__title-accent">{t.hero.titleAccent}</span>
        </h1>

        <p class="hero__desc reveal delay-1">
          {t.hero.description}
        </p>

        <div class="hero__actions reveal delay-2">
          <a 
            href="#contact" 
            class="btn btn--gold" 
            id="hero-primary-cta"
            data-open-modal="lead-modal"
            data-modal-title={lang === 'en' ? 'Order Web Development' : 'Заказать разработку'}
            data-modal-source="Hero: Заказать разработку"
          >
            <span>{t.hero.orderDev}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a href={lang === 'en' ? '/en/portfolio' : '/portfolio'} class="btn btn--glass" id="hero-secondary-cta">
            <svg class="hero__icon-amethyst" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-amethyst-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
            </svg>
            <span>{t.hero.viewPortfolio}</span>
          </a>
        </div>

        {/* Quick Metrics / Signals */}
        <div class="hero__stats reveal delay-3">
          <div class="stat-item">
            <div class="stat-item__value">
              {t.hero.stat1Value}<span class="stat-item__value-accent">{t.hero.stat1Unit}</span>
            </div>
            <div class="stat-item__label">{t.hero.stat1Label}</div>
          </div>

          <div class="stat-item">
            <div class="stat-item__value">
              {t.hero.stat2Value}<span class="stat-item__value-accent">{t.hero.stat2Unit}</span>
            </div>
            <div class="stat-item__label">{t.hero.stat2Label}</div>
          </div>

          <div class="stat-item">
            <div class="stat-item__value">
              {t.hero.stat3Value}<span class="stat-item__value-accent">{t.hero.stat3Unit}</span>
            </div>
            <div class="stat-item__label">{t.hero.stat3Label}</div>
          </div>
        </div>
      </div>

      {/* Right Column: 3D Glassmorphic Interactive Island */}
      <div class="reveal reveal--scale delay-1">
        <Hero3DIsland lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-amethyst-light);
    margin-bottom: 24px;
  }

  :global([data-theme="light"]) .hero__tag {
    color: var(--color-amethyst);
  }

  .hero__tag-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cyan-neon);
    box-shadow: 0 0 10px var(--color-cyan-neon);
    animation: pulseBadge 2s infinite ease-in-out;
  }

  @keyframes pulseBadge {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .hero__title {
    margin-bottom: 24px;
    font-size: 56px;
    line-height: 1;
  }

  @media(max-width: 500px) {
    .hero__title {
      font-size: 40px;
    }
  }

  :global(.hero__title-accent) {
    background: linear-gradient(135deg, var(--color-amethyst-light) 0%, var(--color-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__desc {
    font-size: clamp(16px, 1.4vw, 20px);
    max-width: 580px;
    margin-bottom: 36px;
  }

  @media (max-width: 960px) {
    .hero__desc {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  @media (max-width: 960px) {
    .hero__actions {
      justify-content: center;
    }
  }

  .hero__stats {
    display: flex;
    align-items: center;
    gap: clamp(10px, 3vw, 40px);
    padding-top: 24px;
    border-top: 1px solid var(--glass-border);
  }

  @media (max-width: 960px) {
    .hero__stats {
      justify-content: center;
    }
  }

  .stat-item__value {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .stat-item__value-accent {
    color: var(--color-gold);
    font-size: 1.2rem;
    margin-left: 2px;
  }

  .stat-item__label {
    font-size: 14px;
    color: var(--text-muted);
  }

  @media(max-width: 400px) {
    .stat-item__value {
      font-size: 20px;
    }
    .stat-item__value-accent {
      font-size: 12px;
    }
    .stat-item__label {
      font-size: 12px;
    }
  }
</style>
