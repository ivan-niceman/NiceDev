---
import { translations } from '../i18n/translations';

export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const t = translations[lang];
const isRu = lang === 'ru';
const faqItems = t.faq.items;

// Generate Schema.org FAQPage structured data for rich search snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<section id="faq" aria-labelledby="faq-heading">
  {/* SEO JSON-LD FAQ Microdata */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container">
    <div class="section-header reveal">
      <div class="section-header__subtitle">{t.faq.subtitle}</div>
      <h2 id="faq-heading">{t.faq.title}</h2>
      <p class="section-header__desc">
        {t.faq.description}
      </p>
    </div>

    {/* Accordion List */}
    <div class="faq__accordion reveal delay-1" id="faq-accordion">
      {faqItems.map((item, idx) => {
        const itemNumber = (idx + 1).toString();

        return (
          <div class="faq-item" id={item.id} data-faq-item>
            <button
              type="button"
              class="faq-item__trigger"
              id={`btn-${item.id}`}
              aria-expanded="false"
              aria-controls={`content-${item.id}`}
            >
              <span class="faq-item__num" aria-hidden="true">{itemNumber}</span>
              <span class="faq-item__question">{item.question}</span>
              <span class="faq-item__icon-wrap" aria-hidden="true">
                <span class="faq-item__icon"></span>
              </span>
            </button>

            <div
              class="faq-item__content"
              id={`content-${item.id}`}
              role="region"
              aria-labelledby={`btn-${item.id}`}
            >
              <div class="faq-item__inner">
                <p class="faq-item__answer">{item.answer}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    {/* Direct Question / Lead Consultation CTA Banner */}
    <div class="faq__cta-box reveal delay-2">
      <div class="faq__cta-content">
        <div class="faq__cta-text">
          <h3 class="faq__cta-title">{t.faq.moreQuestionTitle}</h3>
          <p class="faq__cta-desc">{t.faq.moreQuestionDesc}</p>
        </div>
      </div>
      <div class="faq__cta-actions">
        <button
          type="button"
          class="btn btn--gold faq__cta-btn"
          data-open-modal="lead-modal"
          data-modal-title={isRu ? 'Задать вопрос' : 'Ask a Question'}
          data-modal-source="FAQ: Задать вопрос"
        >
          <span>{t.faq.askBtn}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .faq__accordion {
    max-width: 920px;
    margin: 48px auto 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
    overflow: hidden;
  }

  .faq-item:hover {
    border-color: rgba(157, 78, 221, 0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  .faq-item.is-open {
    border-color: rgba(255, 200, 87, 0.45);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), 0 0 20px rgba(157, 78, 221, 0.15);
  }

  :global([data-theme="light"]) .faq-item {
    background: #FFFFFF;
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="light"]) .faq-item:hover {
    border-color: rgba(157, 78, 221, 0.35);
    background: #FCFBFF;
  }

  :global([data-theme="light"]) .faq-item.is-open {
    border-color: var(--color-amethyst);
    background: #FFFFFF;
    box-shadow: 0 10px 28px rgba(157, 78, 221, 0.1);
  }

  .faq-item__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-primary);
    font-family: inherit;
    transition: color var(--transition-fast);
  }

  .faq-item__trigger:focus-visible {
    outline: 2px solid var(--color-amethyst);
    outline-offset: -2px;
  }

  .faq-item__num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-gold);
    opacity: 0.85;
    flex-shrink: 0;
    letter-spacing: 0.04em;
  }

  .faq-item__question {
    flex: 1;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .faq-item:hover .faq-item__question {
    color: var(--text-primary);
  }

  .faq-item.is-open .faq-item__question {
    color: #FFFFFF;
  }

  :global([data-theme="light"]) .faq-item.is-open .faq-item__question {
    color: var(--color-amethyst);
  }

  .faq-item__icon-wrap {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-fast), border-color var(--transition-fast);
  }

  :global([data-theme="light"]) .faq-item__icon-wrap {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .faq-item__icon {
    position: relative;
    width: 14px;
    height: 14px;
    display: block;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    background: var(--color-gold);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background var(--transition-fast);
  }

  /* Horizontal bar */
  .faq-item__icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    border-radius: 2px;
  }

  /* Vertical bar */
  .faq-item__icon::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
    border-radius: 2px;
  }

  .faq-item.is-open .faq-item__icon-wrap {
    background: rgba(255, 200, 87, 0.15);
    border-color: var(--color-gold);
    transform: rotate(45deg);
  }

  .faq-item.is-open .faq-item__icon::after {
    opacity: 0;
  }

  /* Silky smooth pure CSS grid animation with zero letter bleeding when closed */
  .faq-item__content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
    overflow: hidden;
    visibility: hidden;
  }

  .faq-item.is-open .faq-item__content {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  .faq-item__inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 20px 0 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, padding 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
  }

  .faq-item.is-open .faq-item__inner {
    opacity: 1;
    visibility: visible;
    padding: 0 20px 18px 20px;
  }

  .faq-item__answer {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 14px;
  }

  :global([data-theme="light"]) .faq-item__answer {
    color: #4A4458;
    border-top-color: rgba(0, 0, 0, 0.06);
  }

  /* Bottom Consultation CTA Banner */
  .faq__cta-box {
    max-width: 920px;
    margin: 48px auto 0;
    padding: 28px 36px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(157, 78, 221, 0.12) 0%, rgba(255, 200, 87, 0.06) 100%);
    border: 1px solid rgba(157, 78, 221, 0.3);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  :global([data-theme="light"]) .faq__cta-box {
    background: linear-gradient(135deg, rgba(157, 78, 221, 0.08) 0%, rgba(255, 200, 87, 0.08) 100%);
    border-color: rgba(157, 78, 221, 0.2);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .faq__cta-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .faq__cta-title {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .faq__cta-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .faq__cta-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .faq__cta-btn,
  .faq__cta-tg {
    height: 48px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
  }

  .faq__cta-btn {
    padding: 0 24px;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .faq__cta-tg {
    gap: 8px;
    padding: 0 20px;
    color: #229ED9;
    background: var(--glass-bg);
    border: 1px solid rgba(34, 158, 217, 0.35);
  }

  .faq__cta-tg:hover {
    background: rgba(34, 158, 217, 0.14);
    border-color: #229ED9;
    box-shadow: 0 0 16px rgba(34, 158, 217, 0.35);
  }

  @media (max-width: 860px) {
    .faq__cta-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 22px;
      gap: 20px;
    }

    .faq__cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .faq__cta-btn,
    .faq__cta-tg {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .faq-item__trigger {
      padding: 10px 14px;
      gap: 10px;
    }

    .faq-item__num,
    .faq-item__question {
      font-size: 14px;
    }

    .faq-item__inner {
      padding: 0 14px;
    }

    .faq-item.is-open .faq-item__inner {
      padding: 0 14px 14px 14px;
    }

    .faq-item__answer {
      font-size: 0.92rem;
      padding-top: 12px;
    }
  }
</style>

<script>
  function initFAQ() {
    const accordion = document.getElementById('faq-accordion');
    if (!accordion) return;

    const items = accordion.querySelectorAll<HTMLElement>('[data-faq-item]');

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('.faq-item__trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close other items for classic accordion behavior
        items.forEach((other) => {
          if (other !== item && other.classList.contains('is-open')) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector<HTMLButtonElement>('.faq-item__trigger');
            otherBtn?.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current item
        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  initFAQ();
  document.addEventListener('astro:page-load', initFAQ);
</script>
