---
export interface Props {
  currentLang?: string;
}

const { currentLang = 'ru' } = Astro.props;

const languages = [
  { code: 'ru', nativeName: 'РУС', fullName: 'Русский (RU)' },
  { code: 'en', nativeName: 'ENG', fullName: 'English (EN)' }
];

const currentLangObj = languages.find(l => l.code === currentLang) || languages[0];
---
<div class="lang-select" id="language-switcher-container" data-lang={currentLang}>
  <button
    type="button"
    class="lang-select__trigger"
    id="language-dropdown-trigger"
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="language-dropdown-menu"
    aria-label="Select Language / Выбрать язык"
  >
    <svg class="lang-select__globe" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-select__name">{currentLangObj.nativeName}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lang-select__chevron" id="lang-chevron">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-select__menu lang-menu-hidden" id="language-dropdown-menu" role="listbox">
    <div class="lang-select__list">
      {languages.map((item) => (
        <button
          type="button"
          data-lang={item.code}
          class={`lang-select__item ${item.code === currentLang ? 'is-selected' : ''}`}
          role="option"
          aria-selected={item.code === currentLang ? 'true' : 'false'}
        >
          <span class="lang-select__item-name">{item.nativeName}</span>
          <span class="lang-select__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .lang-select {
    position: relative;
    display: inline-block;
  }

  .lang-select__trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    transition: all var(--transition-fast);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    user-select: none;
  }

  .lang-select__globe {
    flex-shrink: 0;
  }

  .lang-select__trigger:hover,
  .lang-select__trigger.is-active {
    border-color: var(--color-gold);
    background: rgba(255, 200, 87, 0.08);
    box-shadow: 0 0 7px var(--color-gold-glow);
  }

  @media (max-width: 500px) {
    .lang-select__trigger {
      padding: 5px;
    }
  }

  .lang-select__chevron {
    color: var(--text-muted);
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .lang-select__chevron.is-rotated {
    transform: rotate(180deg);
    color: var(--color-gold);
  }

  .lang-select__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 110px;
    background: var(--bg-elevated);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 6px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 0 7px rgba(0, 0, 0, 0.35), 0 0 7px var(--color-amethyst-glow);
    z-index: 120;
    animation: langFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang-menu-hidden {
    display: none;
  }

  @keyframes langFadeIn {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lang-select__list {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
  }

  .lang-select__item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: left;
    box-sizing: border-box;
  }

  .lang-select__item:hover {
    background: rgba(157, 78, 221, 0.12);
    border-color: rgba(157, 78, 221, 0.25);
    color: var(--text-primary);
  }

  .lang-select__item.is-selected {
    background: rgba(255, 200, 87, 0.12);
    border-color: rgba(255, 200, 87, 0.3);
    font-weight: 600;
  }

  :global([data-theme="light"]) .lang-select__trigger:hover,
  :global([data-theme="light"]) .lang-select__trigger.is-active {
    background: rgba(207, 130, 71, 0.08);
  }

  :global([data-theme="light"]) .lang-select__item.is-selected {
    background: rgba(207, 130, 71, 0.1);
    border-color: rgba(207, 130, 71, 0.28);
  }

  .lang-select__item-name {
    color: var(--text-primary);
    white-space: nowrap;
  }

  .lang-select__check {
    color: var(--color-gold);
    flex-shrink: 0;
    margin-left: 10px;
    display: none;
  }

  .lang-select__item.is-selected .lang-select__check {
    display: inline-block;
  }
</style>

<script>
  import type { SupportedLanguage } from '../i18n/translations';
  import { applyClientTranslations } from '../i18n/client-i18n';

  // LanguageSelect: accessible combobox with instant in-place language change (no reload, no URL change)
  // Expose transition function on window for direct calls from markup
  declare global {
    interface Window {
      changeLanguageWithTransition: ((lang: SupportedLanguage) => void) | null;
    }
  }
  window.changeLanguageWithTransition = null;

  function initLanguageSelect() {
    const trigger = document.getElementById('language-dropdown-trigger') as HTMLElement | null;
    const menu = document.getElementById('language-dropdown-menu') as HTMLElement | null;
    const chevron = document.getElementById('lang-chevron') as HTMLElement | null;

    if (!trigger || !menu) {
      return;
    }

    const languages = [
      { code: 'ru', nativeName: 'РУС' },
      { code: 'en', nativeName: 'ENG' }
    ];

    // Get current language from document element or localStorage
    function getCurrentLang(): SupportedLanguage {
      try {
        const stored = localStorage.getItem('nicedev-language-preference');
        if (stored === 'en' || stored === 'ru') return stored;
      } catch {}
      const htmlLang = document.documentElement.getAttribute('lang');
      if (htmlLang === 'en') {
        return 'en';
      }
      return 'ru';
    }

    // Apply language to UI and <html lang>
    function applyLanguage(lang: string) {
      document.documentElement.setAttribute('lang', lang);
      const container = document.getElementById('language-switcher-container');
      if (container) {
        container.setAttribute('data-lang', lang);
      }
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        // Update trigger label
        const langObj = languages.find(l => l.code === lang);
        if (langObj) {
          const nameSpan = trigger.querySelector('.lang-select__name');
          if (nameSpan) nameSpan.textContent = langObj.nativeName;
        }
      }
      // Update menu items
      if (menu) {
        const items = menu.querySelectorAll('.lang-select__item');
        items.forEach(item => {
          const itemLang = item.getAttribute('data-lang');
          if (itemLang === lang) {
            item.classList.add('is-selected');
            item.setAttribute('aria-selected', 'true');
          } else {
            item.classList.remove('is-selected');
            item.setAttribute('aria-selected', 'false');
          }
        });
      }
      try { localStorage.setItem('nicedev-language-preference', lang); } catch {}
    }

    // Seamless in-place language change with NO page reload and NO URL change
    function changeLanguageWithTransition(lang: SupportedLanguage) {
      // Update switcher UI immediately
      applyLanguage(lang);

      // Perform instant in-place DOM translation across all page sections
      applyClientTranslations(lang);

      // Close dropdown menu
      closeMenu();
    }

    // Expose the transition function globally so markup can call it directly
    window.changeLanguageWithTransition = changeLanguageWithTransition;

    // Menu state
    let isMenuOpen = false;

    // Menu toggle
    function openMenu() {
      if (!trigger || !menu) return;
      isMenuOpen = true;
      menu.classList.remove('lang-menu-hidden');
      menu.style.display = 'block';
      trigger.classList.add('is-active');
      trigger.setAttribute('aria-expanded', 'true');
      if (chevron) chevron.style.transform = 'rotate(180deg)';
      // Move focus to first item
      const firstItem = menu.querySelector('.lang-select__item');
      if (firstItem) (firstItem as HTMLElement).focus();
    }
    function closeMenu(focusTrigger = false) {
      if (!trigger || !menu) return;
      const wasOpen = isMenuOpen;
      isMenuOpen = false;
      menu.style.display = 'none';
      menu.classList.add('lang-menu-hidden');
      trigger.classList.remove('is-active');
      trigger.setAttribute('aria-expanded', 'false');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
      if (wasOpen && focusTrigger) {
        (trigger as HTMLElement).focus();
      }
    }
    function toggleMenu() {
      if (isMenuOpen) {
        closeMenu(true);
      } else {
        openMenu();
      }
    }

    trigger!.addEventListener('click', e => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', e => {
      if (!isMenuOpen) return;
      const target = e.target as Node | null;
      if (trigger && menu && target && !trigger.contains(target) && !menu.contains(target)) {
        closeMenu(false);
      }
    });

    // Menu item click handlers
    const menuItems = menu.querySelectorAll('.lang-select__item');
    menuItems.forEach(item => {
      item.addEventListener('click', e => {
        e.stopPropagation();
        const lang = (item as HTMLElement).getAttribute('data-lang');
        closeMenu(false);
        if (lang && window.changeLanguageWithTransition) {
          window.changeLanguageWithTransition(lang as SupportedLanguage);
        }
      });
    });

    // Keyboard navigation
    trigger.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleMenu();
      }
      if (e.key === 'Escape') {
        closeMenu(true);
      }
    });

    // Menu key handling
    menu.addEventListener('keydown', e => {
      if (!menu) return;
      const items = Array.from(menu.querySelectorAll('.lang-select__item'));
      const target = e.target as Element | null;
      if (!target) return;
      const index = items.indexOf(target);
      if (index === -1) return;

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          const next = items[(index + 1) % items.length];
          (next as HTMLElement).focus();
          break;
        case 'ArrowUp':
          e.preventDefault();
          const prev = items[(index - 1 + items.length) % items.length];
          (prev as HTMLElement).focus();
          break;
        case 'Home':
          e.preventDefault();
          (items[0] as HTMLElement).focus();
          break;
        case 'End':
          e.preventDefault();
          (items[items.length - 1] as HTMLElement).focus();
          break;
        case 'Enter':
        case ' ':
          e.preventDefault();
          const langTarget = e.target as HTMLElement | null;
          const lang = langTarget ? langTarget.getAttribute('data-lang') : null;
          if (lang && window.changeLanguageWithTransition) window.changeLanguageWithTransition(lang as SupportedLanguage);
          closeMenu(true);
          break;
        case 'Escape':
          e.preventDefault();
          closeMenu(true);
          break;
      }
    });

    // Listen for language change requests from the menu buttons (they dispatch custom event)
    // Keeping this as a fallback in case direct call fails
    window.addEventListener('nice-dev:language-change-request', (e) => {
      const detail = (e as CustomEvent<{ lang: string }>).detail;
      if (detail?.lang) {
        changeLanguageWithTransition(detail.lang as SupportedLanguage);
      }
    });

    // Also sync UI when a language-change event is broadcasted
    window.addEventListener('nice-dev:language-change', (e) => {
      const detail = (e as CustomEvent<{ lang: string }>).detail;
      if (detail?.lang && (detail.lang === 'ru' || detail.lang === 'en')) {
        applyLanguage(detail.lang);
      }
    });

    // Initialize UI based on current language from document / storage
    const initialLang = getCurrentLang();
    applyLanguage(initialLang);
    if (initialLang === 'en') {
      applyClientTranslations('en');
    }

    // Re‑init on Astro page navigations (SPA transitions)
    const reinit = () => {
      const currentLang = getCurrentLang();
      applyLanguage(currentLang);
    };
    document.addEventListener('astro:page-load', reinit);
    window.addEventListener('popstate', reinit);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageSelect);
  } else {
    initLanguageSelect();
  }
</script>