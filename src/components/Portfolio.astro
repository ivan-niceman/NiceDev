---
import { translations } from '../i18n/translations';
import ProjectCard from './ProjectCard.astro';
import { portfolioProjects } from '../data/portfolio';

export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const t = translations[lang];
const isRu = lang === 'ru';
const portfolioLink = '/portfolio';

// Showcase 2 featured flagship projects on homepage
const featuredProjects = portfolioProjects.slice(0, 2);
---

<section id="portfolio" aria-labelledby="portfolio-heading">
  <div class="container">
    <div class="section-header reveal">
      <div class="section-header__subtitle">{t.portfolio.subtitle}</div>
      <h2 id="portfolio-heading">{t.portfolio.title}</h2>
      <p class="section-header__desc">
        {isRu
          ? 'Показываем реальные проекты в действии. В каждой карточке десктопная и мобильная версии непрерывно двигаются — наведите курсор, чтобы приостановить.'
          : 'Live previews of our crafted platforms. Desktop and mobile versions move continuously — hover over any card to pause.'}
      </p>
    </div>

    {/* Featured Projects Grid — without quick filters */}
    <div class="portfolio-grid">
      {featuredProjects.map((project, idx) => (
        <div class={`reveal delay-${idx + 1}`}>
          <ProjectCard 
            project={project} 
            lang={lang} 
            priority={idx === 0} 
          />
        </div>
      ))}
    </div>

    {/* Primary Link to Full Portfolio Page */}
    <div class="portfolio-action-row reveal delay-2">
      <a href={portfolioLink} class="btn btn--gold portfolio-all-btn">
        <span>{isRu ? 'Смотреть проекты' : 'Explore Projects'}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <span class="portfolio-hint">
        {isRu ? 'Все проекты с живой анимацией доступны на отдельной странице' : 'All projects with live scrolling available on dedicated page'}
      </span>
    </div>
  </div>
</section>

<style>
  .section-header__desc {
    margin-top: 14px;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  @media (max-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .portfolio-action-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 48px;
  }

  .portfolio-hint {
    font-size: 12px;
    color: var(--text-muted);
    text-align: center;
  }
</style>
