---
import Logo from './Logo.astro';
import Navbar from './Navbar.astro';
import { translations } from '../i18n/translations';

export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const t = translations[lang];
const privacyLink = '/privacy-policy';
const consentLink = '/personal-data-consent';
---

<footer class="footer" id="main-footer">
  <div class="container">
    <div class="footer__grid reveal">
      {/* Brand & Description Column */}
      <div class="footer__brand-col">
        <Logo/>

        <p class="footer__brand-desc" id="footer-brand-desc">
          {t.footer.brandDesc}
        </p>
      </div>

      {/* Navigation Links Column via pure Navbar Component (DRY) */}
      <div class="footer__col">
        <h4 class="footer__heading" id="footer-heading-nav">{t.footer.navHeading}</h4>
        <Navbar lang={lang} variant="footer" />
      </div>

      {/* Direct Communication & Messengers */}
      <div class="footer__col">
        <h4 class="footer__heading" id="footer-heading-geo">{t.footer.geoHeading}</h4>
        <ul>
          <li>
            <a href="https://t.me/ivan_niceman" target="_blank" rel="noopener noreferrer" class="footer__contact-link">
              <span class="footer__contact-dot footer__contact-dot--tg"></span>
              <span>Telegram</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/79067075235" target="_blank" rel="noopener noreferrer" class="footer__contact-link">
              <span class="footer__contact-dot footer__contact-dot--wa"></span>
              <span>WhatsApp</span>
            </a>
          </li>
          <li>
            <a href="https://max.ru/u/f9LHodD0cOKVE5qofs_rxTYqArSbNOWAMh5acGm-JdIQJTRyQVCBrugo8Zk" target="_blank" rel="noopener noreferrer" class="footer__contact-link">
              <span class="footer__contact-dot footer__contact-dot--max"></span>
              <span>Max</span>
            </a>
          </li>
          <li>
            <a href="mailto:info@nice-dev.ru" class="footer__contact-link">
              <span class="footer__contact-dot footer__contact-dot--email"></span>
              <span>E-mail</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar: Copyright & Compliance */}
    <div class="footer__bottom">
      <div class="footer__legal">
        <button type="button" class="footer__legal-link footer__cookie-btn" id="footer-cookie-btn">
          {t.footer.cookieSettings || (lang === 'ru' ? 'Настройки Cookie' : 'Cookie Settings')}
        </button>
        <a href={privacyLink} class="footer__legal-link" id="footer-legal-privacy">
          {t.footer.privacyPolicy}
        </a>
        <a href={consentLink} class="footer__legal-link" id="footer-legal-consent">
          {t.footer.personalDataConsent}
        </a>
      </div>
      <div class="footer__copy" id="footer-copy">
        © {t.footer.rights}
      </div>
    </div>
    {t.footer.whatsappDisclaimer && (
      <div class="footer__disclaimer">
        <p id="footer-whatsapp-disclaimer">{t.footer.whatsappDisclaimer}</p>
      </div>
    )}
  </div>

    {/* Brand Copyright */}
    <a href="/" class="footer__brand-copyright">
      <span>© Nice Dev Web-Studio 2020 - {new Date().getFullYear()}</span>
    </a>
</footer>

<script>
  function setupFooterCookieBtn() {
    const cookieBtn = document.getElementById('footer-cookie-btn');
    if (cookieBtn) {
      cookieBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-cookie-settings'));
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooterCookieBtn);
  } else {
    setupFooterCookieBtn();
  }
  document.addEventListener('astro:page-load', setupFooterCookieBtn);
</script>

<style>
  .footer {
    position: relative;
    background: var(--bg-secondary);
    border-top: 1px solid var(--glass-border);
    padding: 50px 0 20px;
    margin-top: 80px;
    z-index: 1;
  }

  @media (max-width: 600px) {
    .footer {
      margin-top: 50px;
    }
  }

  .footer__grid {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 50px;
  }

  .footer__col {
    max-width: 30%;
    width: 100%;
  }
  .footer__col:last-of-type {
    max-width: 20%;
  }

  @media(max-width: 500px) {
    .footer__brand-col {
      text-align: center;
      width: 100%;
    }
    .footer__brand-desc {
      margin-inline: auto;
    }
    .footer__col {
      max-width: 60%;
    }
    .footer__col:last-of-type {
      max-width: 30%;
    }
  }

  .footer__brand-desc {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 10px;
    max-width: 320px;
    line-height: 1.5;
  }

  .footer__metrics-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cyan-neon);
    box-shadow: 0 0 6px var(--color-cyan-neon);
  }

  .footer__metrics-text {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-cyan-neon);
  }

  .footer__heading {
    font-size: 16px;
    color: var(--text-primary);
    margin-top: 0;
    margin-bottom: 20px;
  }

  .footer__link {
    font-size: 14px;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-gold);
  }

  .footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer__contact-link:hover {
    color: var(--text-primary);
  }

  .footer__contact-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .footer__contact-dot--tg {
    background: #0088CC;
  }

  .footer__contact-dot--wa {
    background: #25D366;
  }

  .footer__contact-dot--max {
    background: #4b1df9;
  }

  .footer__contact-dot--phone {
    background: var(--color-cyan-neon);
  }

  .footer__contact-dot--email {
    background: var(--color-gold);
  }

  /* Bottom Bar */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--glass-border);
  }

  .footer__copy {
    font-size: 12px;
    color: var(--text-muted);
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
  }

  .footer__legal-link {
    font-size: 12px;
    width: fit-content;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .footer__cookie-btn {
    width: fit-content;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .footer__legal-link:hover,
  .footer__cookie-btn:hover {
    color: var(--color-gold);
    text-decoration-color: var(--color-gold);
  }
  .footer__disclaimer {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

:global([data-theme="light"]) .footer__disclaimer {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.footer__disclaimer p {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.2;
  opacity: 0.85;
}

.footer__brand-copyright {
  display: block;
  margin-top: 40px;
  margin-inline: auto;
  width: fit-content;
  }

  .footer__brand-copyright span {
    font-size: 10px;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.02em;
  }
</style>
