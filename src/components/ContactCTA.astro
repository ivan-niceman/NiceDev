---
import { translations } from '../i18n/translations';

export interface Props {
  lang?: 'ru' | 'en';
}

const { lang = 'ru' } = Astro.props;
const t = translations[lang];
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="nd-container">
    <div class="nd-contact-grid">
      {/* Left Column: Direct Contacts & Value Promise */}
      <div class="nd-reveal nd-reveal--left">
        <div class="nd-section-header__subtitle nd-section-header__subtitle--left">
          {t.contact.subtitle}
        </div>
        <h2 id="contact-heading" class="nd-contact-title">
          {t.contact.title}
        </h2>
        <p class="nd-contact-desc">
          {t.contact.description}
        </p>

        <div class="nd-contact-list">
          <div class="nd-contact-item nd-reveal nd-delay-1">
            <div class="nd-contact-icon nd-contact-icon--tg" style="background: rgba(0, 136, 204, 0.15); color: #0088CC; border: 1px solid rgba(0, 136, 204, 0.3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
            </div>
            <div>
              <div class="nd-contact-info-label">{lang === 'en' ? 'Messenger' : 'Мессенджер'}</div>
              <a href="https://t.me/ivan_niceman" target="_blank" rel="noopener noreferrer" class="nd-contact-link">
                Telegram
              </a>
            </div>
          </div>

          <div class="nd-contact-item nd-reveal nd-delay-1">
            <div class="nd-contact-icon nd-contact-icon--wa" style="background: rgba(37, 211, 102, 0.15); color: #25D366; border: 1px solid rgba(37, 211, 102, 0.3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div>
              <div class="nd-contact-info-label">{lang === 'en' ? 'Messenger' : 'Мессенджер'}</div>
              <a href="https://wa.me/79067075235" target="_blank" rel="noopener noreferrer" class="nd-contact-link">
                WhatsApp
              </a>
            </div>
          </div>

          <div class="nd-contact-item nd-reveal nd-delay-2">
            <div class="nd-contact-icon nd-contact-icon--max" style="background: rgba(168, 85, 247, 0.15); color: #A855F7; border: 1px solid rgba(168, 85, 247, 0.3);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21a9 9 0 0 1-5.7-2.1L3 21l1.9-5.7a9 9 0 1 1 7.1 5.7Z"></path>
                <circle cx="12.5" cy="11.5" r="4.2"></circle>
              </svg>
            </div>
            <div>
              <div class="nd-contact-info-label">{lang === 'en' ? 'Messenger' : 'Мессенджер'}</div>
              <a href="https://max.ru/u/f9LHodD0cOKVE5qofs_rxTYqArSbNOWAMh5acGm-JdIQJTRyQVCBrugo8Zk" target="_blank" rel="noopener noreferrer" class="nd-contact-link">
                Max
              </a>
            </div>
          </div>

          <div class="nd-contact-item nd-reveal nd-delay-3">
            <div class="nd-contact-icon nd-contact-icon--amethyst">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <div class="nd-contact-info-label">E-mail</div>
              <a href="mailto:info@nice-dev.ru" class="nd-contact-link">
                info@nice-dev.ru
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Right Column: Contact Form */}
      <div class="nd-reveal nd-reveal--right nd-delay-1 nd-form-card">
        <div id="form-success-box" class="nd-form-success-box">
          <div class="nd-form-success-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="nd-form-success-title">{t.contact.successTitle}</h3>
          <p class="nd-form-success-desc">
            {t.contact.successDesc}
          </p>
          <button 
            type="button" 
            class="nd-btn nd-btn--glass" 
            id="send-another-btn"
          >
            {t.contact.sendAnother}
          </button>
        </div>

        <form id="consultation-form" novalidate>
          {/* Anti-spam hidden honeypot fields for bot traps */}
          <div style="position: absolute; left: -9999px; top: -9999px; opacity: 0; pointer-events: none; width: 0; height: 0; overflow: hidden;" aria-hidden="true" tabindex="-1">
            <input type="text" name="company_website" id="cta-company-website" tabindex="-1" autocomplete="off" />
            <input type="text" name="_gotcha" id="cta-gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <h3 class="nd-form-title">{t.contact.formTitle}</h3>

          {/* Name Field with Floating Placeholder */}
          <div class="nd-input-group" id="group-client-name">
            <div class="nd-floating-field" id="field-client-name">
              <input 
                type="text" 
                id="client-name" 
                name="name"
                required 
                class="nd-input" 
                placeholder=" "
                autocomplete="name"
              />
              <label class="nd-floating-label" for="client-name">{t.contact.nameLabel}</label>
            </div>
            <div class="nd-field-error" id="error-client-name">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>{t.contact.validation.nameRequired}</span>
            </div>
          </div>

          <div class="nd-form-row">
            {/* Phone Field with Floating Placeholder */}
            <div class="nd-input-group" id="group-client-phone">
              <div class="nd-floating-field" id="field-client-phone">
                <input 
                  type="tel" 
                  id="client-phone" 
                  name="phone"
                  required 
                  class="nd-input" 
                  placeholder=" "
                  autocomplete="tel"
                  inputmode="tel"
                />
                <label class="nd-floating-label" for="client-phone">{t.contact.phoneInputLabel}</label>
              </div>
              <div class="nd-field-error" id="error-client-phone">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>{t.contact.validation.phoneRequired}</span>
              </div>
            </div>

            {/* Email Field with Floating Placeholder */}
            <div class="nd-input-group" id="group-client-email">
              <div class="nd-floating-field" id="field-client-email">
                <input 
                  type="email" 
                  id="client-email" 
                  name="email"
                  required
                  class="nd-input" 
                  placeholder=" "
                  autocomplete="email"
                  inputmode="email"
                />
                <label class="nd-floating-label" for="client-email">{t.contact.emailInputLabel}</label>
              </div>
              <div class="nd-field-error" id="error-client-email">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>{t.contact.validation.emailInvalid}</span>
              </div>
            </div>
          </div>

          {/* Message Textarea with Floating Placeholder */}
          <div class="nd-input-group" id="group-client-message">
            <div class="nd-floating-field" id="field-client-message">
              <textarea 
                id="client-message" 
                name="message"
                rows={3} 
                class="nd-textarea" 
                placeholder=" "
              ></textarea>
              <label class="nd-floating-label" for="client-message">{t.contact.messageLabel}</label>
            </div>
          </div>

          {/* Agreement Checkbox with Validation */}
          <div class="nd-checkbox-group" id="group-client-agreement">
            <label class="nd-checkbox-label">
              <input 
                type="checkbox" 
                id="client-agreement"
                name="personal_data_agreement" 
                required 
                checked
                class="nd-checkbox-input"
              />
              <span>
                {lang === 'ru' ? (
                  <>
                    Нажимая кнопку, я даю <a href="/personal-data-consent" target="_blank" class="nd-legal-link">согласие на обработку персональных данных</a> в соответствии с <a href="/privacy-policy" target="_blank" class="nd-legal-link">Политикой конфиденциальности</a> по 152-ФЗ.
                  </>
                ) : (
                  <>
                    By submitting this form, I agree to the <a href="/en/personal-data-consent" target="_blank" class="nd-legal-link">Personal Data Processing</a> in accordance with the <a href="/en/privacy-policy" target="_blank" class="nd-legal-link">Privacy Policy</a>.
                  </>
                )}
              </span>
            </label>
            <div class="nd-field-error" id="error-client-agreement">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>{t.contact.validation.agreementRequired}</span>
            </div>
          </div>

          <button type="submit" class="nd-btn nd-btn--gold nd-submit-btn" id="submit-form-btn">
            <span>{t.contact.submitBtn}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .nd-section-header__subtitle--left {
    text-align: left;
  }

  .nd-contact-title {
    margin-bottom: 18px;
  }

  .nd-contact-desc {
    margin-bottom: 32px;
  }

  .nd-contact-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .nd-contact-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nd-contact-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nd-contact-icon--gold {
    color: var(--color-gold);
  }

  .nd-contact-icon--amethyst {
    color: var(--color-amethyst-light);
  }

  .nd-contact-icon--cyan {
    color: var(--color-cyan-neon);
  }

  .nd-contact-info-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .nd-contact-link {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .nd-contact-link:hover {
    color: var(--color-gold);
  }

  .nd-contact-info-val {
    font-weight: 600;
    color: var(--text-primary);
  }

  .nd-form-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: clamp(24px, 4vw, 40px);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: var(--glass-shadow);
  }

  .nd-form-success-box {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .nd-form-success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(0, 245, 212, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
    color: var(--color-cyan-neon);
  }

  .nd-form-success-title {
    font-size: 1.6rem;
    margin-bottom: 10px;
  }

  .nd-form-success-desc {
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .nd-form-title {
    font-size: 1.4rem;
    margin-bottom: 20px;
  }

  .nd-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 640px) {
    .nd-form-row {
      grid-template-columns: 1fr;
    }
  }

  .nd-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    cursor: pointer;
    line-height: 1.4;
  }

  .nd-checkbox-input {
    margin-top: 3px;
    accent-color: var(--color-gold);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nd-legal-link {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nd-submit-btn {
    width: 100%;
    padding: 14px;
  }

  :global(.nd-spinner-spin) {
    animation: spin 1s linear infinite;
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    const successBox = document.getElementById('form-success-box');
    const sendAnotherBtn = document.getElementById('send-another-btn');

    if (!form || !successBox) return;

    const formInitTime = Date.now();

    const nameInput = document.getElementById('client-name') as HTMLInputElement | null;
    const phoneInput = document.getElementById('client-phone') as HTMLInputElement | null;
    const emailInput = document.getElementById('client-email') as HTMLInputElement | null;
    const agreementInput = document.getElementById('client-agreement') as HTMLInputElement | null;

    const nameField = document.getElementById('field-client-name');
    const phoneField = document.getElementById('field-client-phone');
    const emailField = document.getElementById('field-client-email');
    const agreementGroup = document.getElementById('group-client-agreement');

    let hasAttemptedSubmit = false;

    function validateName(showUi = hasAttemptedSubmit): boolean {
      if (!nameInput || !nameField) return true;
      const isValid = nameInput.value.trim().length >= 2;
      if (showUi) {
        if (!isValid) {
          nameField.classList.add('has-error');
        } else {
          nameField.classList.remove('has-error');
        }
      }
      return isValid;
    }

    function validatePhone(showUi = hasAttemptedSubmit): boolean {
      if (!phoneInput || !phoneField) return true;
      const raw = phoneInput.value.trim();
      // Must contain only digits, +, -, (, ), spaces
      const validChars = /^[0-9+\-\s()]+$/.test(raw);
      // Must have between 7 and 15 digits (standard international phone standard E.164)
      const digitsCount = raw.replace(/\D/g, '').length;
      const isValid = validChars && digitsCount >= 7 && digitsCount <= 15;
      
      if (showUi) {
        if (!isValid) {
          phoneField.classList.add('has-error');
        } else {
          phoneField.classList.remove('has-error');
        }
      }
      return isValid;
    }

    function validateEmail(showUi = hasAttemptedSubmit): boolean {
      if (!emailInput || !emailField) return true;
      const val = emailInput.value.trim();
      // Email is required and must follow standard email structure with domain and valid TLD
      const emailPattern = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;
      const parts = val.split('@');
      const domain = parts[1] || '';
      const tld = domain.split('.').pop() || '';
      const isValid = emailPattern.test(val) && parts.length === 2 && domain.includes('.') && tld.length >= 2 && val.length >= 5 && val.length <= 254;
      
      if (showUi) {
        if (!isValid) {
          emailField.classList.add('has-error');
        } else {
          emailField.classList.remove('has-error');
        }
      }
      return isValid;
    }

    function validateAgreement(showUi = hasAttemptedSubmit): boolean {
      if (!agreementInput || !agreementGroup) return true;
      const isValid = agreementInput.checked;
      if (showUi) {
        if (!isValid) {
          agreementGroup.classList.add('has-error');
        } else {
          agreementGroup.classList.remove('has-error');
        }
      }
      return isValid;
    }

    // Restrict phone input to ONLY digits, +, -, (, ), spaces
    if (phoneInput) {
      phoneInput.addEventListener('keydown', (e: KeyboardEvent) => {
        // Allow control keys: Backspace, Tab, Enter, Escape, Delete, Arrow keys, Home, End, Ctrl/Cmd shortcuts
        if (
          ['Backspace', 'Tab', 'Enter', 'Escape', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key) ||
          e.ctrlKey || e.metaKey
        ) {
          return;
        }
        // Allow digits, +, -, (, ), space
        if (!/^[0-9+\-\s()]$/.test(e.key)) {
          e.preventDefault();
        }
      });

      // Filter paste and direct input events to remove invalid characters
      phoneInput.addEventListener('input', () => {
        const cleaned = phoneInput.value.replace(/[^0-9+\-\s()]/g, '');
        if (phoneInput.value !== cleaned) {
          phoneInput.value = cleaned;
        }
        if (hasAttemptedSubmit || phoneField?.classList.contains('has-error')) {
          validatePhone(true);
        }
      });
    }

    // Live validation on input only when submitted or in error
    nameInput?.addEventListener('input', () => {
      if (hasAttemptedSubmit || nameField?.classList.contains('has-error')) {
        validateName(true);
      }
    });

    emailInput?.addEventListener('input', () => {
      if (hasAttemptedSubmit || emailField?.classList.contains('has-error')) {
        validateEmail(true);
      }
    });

    agreementInput?.addEventListener('change', () => {
      if (hasAttemptedSubmit || agreementGroup?.classList.contains('has-error')) {
        validateAgreement(true);
      }
    });

    const submitBtn = document.getElementById('submit-form-btn') as HTMLButtonElement | null;
    const originalBtnText = submitBtn ? submitBtn.innerHTML : '';

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hasAttemptedSubmit = true;

      const isNameValid = validateName(true);
      const isPhoneValid = validatePhone(true);
      const isEmailValid = validateEmail(true);
      const isAgreementValid = validateAgreement(true);

      if (isNameValid && isPhoneValid && isEmailValid && isAgreementValid) {
        hasAttemptedSubmit = false;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.7';
          submitBtn.innerHTML = `
            <svg class="nd-spinner nd-spinner-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
            </svg>
            <span>Отправка данных...</span>
          `;
        }

        try {
          const honeypotInput = document.getElementById('cta-company-website') as HTMLInputElement | null;
          const gotchaInput = document.getElementById('cta-gotcha') as HTMLInputElement | null;

          const payload = {
            name: nameInput?.value.trim(),
            phone: phoneInput?.value.trim(),
            email: emailInput?.value.trim(),
            message: (document.getElementById('client-message') as HTMLTextAreaElement)?.value.trim() || '',
            source: 'Consultation Form',
            company_website: honeypotInput?.value || '',
            _gotcha: gotchaInput?.value || '',
            _time: formInitTime,
          };

          await fetch('/api/send-lead', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          // Show success state
          form.style.display = 'none';
          successBox.style.display = 'block';
        } catch (err) {
          console.warn('Fallback submission handled:', err);
          // Show success state gracefully so client is assured their inquiry is logged
          form.style.display = 'none';
          successBox.style.display = 'block';
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.innerHTML = originalBtnText;
          }
        }
      } else {
        // Focus first invalid field
        if (!isNameValid) {
          nameInput?.focus();
        } else if (!isPhoneValid) {
          phoneInput?.focus();
        } else if (!isEmailValid) {
          emailInput?.focus();
        }
      }
    });

    if (sendAnotherBtn) {
      sendAnotherBtn.addEventListener('click', () => {
        form.reset();
        nameField?.classList.remove('has-error');
        phoneField?.classList.remove('has-error');
        emailField?.classList.remove('has-error');
        agreementGroup?.classList.remove('has-error');
        form.style.display = 'block';
        successBox.style.display = 'none';
      });
    }
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
