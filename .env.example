# NiceDev Environment Variables Example Template
# Copy this file to .env and fill in your secrets

# ----------------------------------------------------
# 1. SMTP Email Configuration (Timeweb Mail)
# ----------------------------------------------------
SMTP_HOST="smtp.timeweb.ru"
SMTP_PORT=465
SMTP_USER="info@nice-dev.ru"
SMTP_PASS=""
SMTP_SECURE=true

# Email Sender & Recipients
SMTP_FROM="NiceDev Web Studio <info@nice-dev.ru>"
SMTP_TO="nice-dev@list.ru,info@nice-dev.ru"

# ----------------------------------------------------
# 2. Telegram Bot Notifications (@NiceDev_bot)
# ----------------------------------------------------
TELEGRAM_BOT_TOKEN=""
# Your personal or group Telegram Chat ID (e.g. 267132665)
TELEGRAM_CHAT_ID=""
